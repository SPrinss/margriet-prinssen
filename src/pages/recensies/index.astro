---
import PageLayout from '../../layouts/PageLayout.astro';
import { getAllReviews, type Review, type Person } from '../../lib/content';
import { MpSearch } from '../../components/lit/MpSearch';

// Fetch all reviews at build time
const reviews: Review[] = await getAllReviews();

// Helper to safely get name from Person object or string
function getName(item: Person | string | undefined | null): string {
  if (!item) return '';
  if (typeof item === 'string') return item;
  return item.name || '';
}

// Page metadata
const title = 'Recensies - Margriet Prinssen';
const description = 'Doorzoek alle theaterrecensies van Margriet Prinssen. Zoeken is mogelijk op titels, gezelschappen, personen, theaters, jaartallen en steden.';
---

<PageLayout title={title} description={description}>
  <div class="page-container">
    <header class="page-header">
      <h2>Doorzoek recensies</h2>
    </header>

    <section class="intro-section">
      <p>
        Zoeken is mogelijk op titels, gezelschappen, personen, theaters,
        jaartallen en steden. Als je binnen een categorie (bijvoorbeeld
        Toneelschuur) wilt zoeken, kan je op 'Gebruik als filter' klikken.
      </p>
    </section>

    <!-- Algolia Search Lit Island -->
    <section class="search-section">
      <MpSearch
        client:only="lit"
        index="reviews"
        placeholder="Zoeken op titel, gezelschap, persoon..."
        allow-filters
        allow-search-titles
        hits-per-page="6"
      />
    </section>

    <section class="content-section">
      <div class="recensie-grid" id="recensie-grid">
        {reviews.map((review) => (
          <a
            href={`/recensies/${review.id}`}
            aria-label={`Navigeer naar ${review.title || review.name}`}
            class="review-card"
            data-review-id={review.id}
          >
            <article class="recensie-preview">
              <header>
                <div class="header-main">
                  {review.title && <h4>{review.title}</h4>}
                  {review.name && <h5>{review.name}</h5>}
                  {review.groups && review.groups.length > 0 && (
                    <div class="groups">
                      {review.groups.map((group) => (
                        <h6>{getName(group)}</h6>
                      ))}
                    </div>
                  )}
                </div>
                <div class="header-meta">
                  <ul>
                    {review.reviewDate && <li>{review.reviewDate}</li>}
                    {review.theater && <li>{getName(review.theater)}</li>}
                    {review.city && <li>{getName(review.city)}</li>}
                  </ul>
                </div>
              </header>
              <section class="persons-section">
                <div class="persons-grid">
                  {review.actors && review.actors.length > 0 && (
                    <ul>
                      <li class="label">{review.actors.length > 1 ? 'Spelers' : 'Speler'}</li>
                      {review.actors.map((actor) => (
                        <li>{getName(actor)}</li>
                      ))}
                    </ul>
                  )}
                  {review.directors && review.directors.length > 0 && (
                    <ul>
                      <li class="label">{review.directors.length > 1 ? 'Regisseurs' : 'Regisseur'}</li>
                      {review.directors.map((director) => (
                        <li>{getName(director)}</li>
                      ))}
                    </ul>
                  )}
                  {review.writers && review.writers.length > 0 && (
                    <ul>
                      <li class="label">{review.writers.length > 1 ? 'Schrijvers' : 'Schrijver'}</li>
                      {review.writers.map((writer) => (
                        <li>{getName(writer)}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>
            </article>
          </a>
        ))}
      </div>

      <a href="https://algolia.com" target="_blank" rel="noopener noreferrer" class="algolia-link">
        <span>Search by Algolia</span>
      </a>
    </section>
  </div>

<script>
  // Hide static grid - MpSearch component handles all results display
  const grid = document.getElementById('recensie-grid');
  if (grid) {
    grid.style.display = 'none';
  }
</script>
</PageLayout>

<style>
  .page-container {
    max-width: var(--mp-page-max-width, 1080px);
    margin: 0 auto;
    padding: var(--mp-size--5);
  }

  .page-header {
    min-height: var(--mp-size--14);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .intro-section {
    text-align: center;
    margin-bottom: var(--mp-size--6);
  }

  .search-section {
    max-width: 660px;
    margin: 0 auto var(--mp-size--6);
  }

  .recensie-grid {
    display: grid;
    gap: var(--mp-size--3);
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
  }

  .review-card {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .recensie-preview {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--mp-border-radius--1);
    box-shadow: var(--mp-box-shadow--1);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .recensie-preview:hover {
    transform: scale(1.01);
    cursor: pointer;
    box-shadow: var(--mp-box-shadow--3);
  }

  .recensie-preview header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: var(--mp-size--4);
    background-color: var(--mp-color-main--60);
    color: var(--mp-color-dark--100);
  }

  .header-main {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
  }

  .header-meta {
    flex: 1;
    text-align: right;
  }

  .header-meta ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .persons-section {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: nowrap;
    padding: var(--mp-size--4);
    background-color: var(--mp-color-secondary--30);
    flex: 1;
  }

  .persons-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--mp-size--3);
  }

  .persons-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .persons-grid ul li.label {
    margin-bottom: var(--mp-size--1);
    color: var(--mp-color-dark--60);
  }

  .algolia-link {
    display: block;
    margin-top: var(--mp-size--4);
    color: var(--mp-color-dark--60);
    font-size: var(--mp-text-c2-font-size);
  }

  /* Dark Mode */
  @media (prefers-color-scheme: dark) {
    .persons-section {
      background-color: var(--mp-color-dark--60);
      color: var(--mp-color-light--100);
    }

    .recensie-preview header {
      background-color: var(--mp-color-main--100);
      color: var(--mp-color-dark--90);
    }

    .persons-grid ul li.label {
      color: var(--mp-color-light--60);
    }
  }

  /* Mobile Responsive */
  @media only screen and (max-width: 660px) {
    .recensie-grid {
      grid-template-columns: 1fr;
    }

    .persons-grid {
      grid-template-columns: 1fr;
    }

    .recensie-preview header {
      flex-direction: column;
      align-items: flex-start;
    }

    .header-meta {
      text-align: left;
      margin-top: var(--mp-size--2);
    }
  }
</style>
