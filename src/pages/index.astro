---
import PageLayout from '../layouts/PageLayout.astro';
import BasicPreview from '../components/BasicPreview.astro';
import { getHomepageContent, type Review, type Interview } from '../lib/content';

// Fetch home page content at build time: the curated selection from
// settings/homepage, or (default) the most recent reviews and interviews.
const { reviews, interviews } = await getHomepageContent(4);

// Helper function to extract names from groups array
function getGroupNames(groups: Array<{ id: string; name: string }> | undefined): string[] {
  if (!groups) return [];
  return groups.map(group => group.name);
}

// Helper function to extract names from persons array
function getPersonNames(persons: Array<{ id: string; name: string }> | undefined): string[] {
  if (!persons) return [];
  return persons.map(person => person.name);
}
---

<PageLayout
  title="Margriet Prinssen - Theaterjournalist"
  description="Margriet Prinssen is theaterjournalist. Lees haar recensies en interviews over theater, dans en opera."
>
  <div class="home-page">
    <header class="hero">
      <h1 id="title"></h1>
      <h2 id="subtitle"></h2>
    </header>

    <section class="intro-section">
      <p>Vanaf 1989 schrijf ik over theater, dans en opera: theaterrecensies voor diverse dagbladen, artikelen voor de Uitkrant, Scenes, theaterkrant.nl, programmaboeken van Nationale Opera & Ballet en Odeon.</p>
      <p>Op deze site kun je recensies vinden op titel of op naam van het gezelschap of de theatermaker. Volledigheid wordt niet nagestreefd. Evidente fouten graag melden via het contactformulier op de <a href="/over">over</a> pagina.</p>
    </section>

    <section class="content-section">
      <h3>Recente publicaties</h3>
      <div class="grid">
        {reviews.map((item: Review) => (
          <BasicPreview
            href={`/recensies/${item.id}`}
            title={item.title || item.name}
            image={item.images && item.images.length > 0 ? item.images[0] : undefined}
            featureList={getGroupNames(item.groups)}
            timePublished={item.reviewDate}
            type="review"
          />
        ))}
      </div>
      <a href="/recensies" class="arrow-link" aria-label="Navigeer naar recensies">Doorzoek recensies</a>
    </section>

    <section class="content-section">
      <div class="grid">
        {interviews.map((item: Interview) => (
          <BasicPreview
            href={`/interviews/${item.id}`}
            title={item.title}
            image={item.images && item.images.length > 0 ? item.images[0] : undefined}
            featureList={getPersonNames(item.persons)}
            timePublished={item.interviewDate}
            type="interview"
          />
        ))}
      </div>
      <a href="/interviews" class="arrow-link" aria-label="Navigeer naar interviews">Doorzoek interviews</a>
    </section>
  </div>
</PageLayout>

<style>
  .home-page {
    max-width: var(--mp-page-max-width, 1080px);
    margin: 0 auto;
    padding: 0 var(--mp-size--5, 20px);
  }

  .hero {
    min-height: 162px;
    margin-bottom: var(--mp-size--7, 32px);
    padding: var(--mp-size--8, 48px);
    text-align: center;
  }

  .hero h1 {
    margin: 0 auto var(--mp-size--3, 12px) auto;
  }

  .hero h2 {
    margin: 0 auto var(--mp-size--3, 12px) auto;
  }

  .intro-section {
    margin-bottom: var(--mp-size--8, 40px);
    animation: ease-in-opacity 2s forwards ease-in-out;
  }

  .intro-section p {
    margin-bottom: var(--mp-size--4, 16px);
  }

  .intro-section a {
    color: inherit;
    text-decoration: underline;
  }

  .intro-section a:hover {
    text-decoration: none;
  }

  .content-section {
    margin-bottom: var(--mp-size--8, 40px);
  }

  .content-section h3 {
    margin-bottom: var(--mp-size--4, 16px);
  }

  .grid {
    display: grid;
    gap: var(--mp-size--3, 12px);
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
  }

  .arrow-link {
    display: inline-block;
    margin: var(--mp-size--4, 16px) 0;
    padding: 0 0 var(--mp-size--3, 12px) 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-family: var(--mp-text-b3-font-family, var(--mp-text-b-font-family));
    font-size: var(--mp-text-b3-font-size);
    font-weight: var(--mp-text-b3-font-weight, var(--mp-text-b-font-weight));
    line-height: var(--mp-text-b3-line-height, var(--mp-text-b-line-height));
    border-bottom: 1px solid var(--mp-color-dark--100);
    text-decoration: none;
    color: inherit;
  }

  .arrow-link::after {
    content: '->';
    padding-left: var(--mp-size--3, 12px);
  }

  @keyframes ease-in-opacity {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  /* Dark Mode */
  @media (prefers-color-scheme: dark) {
    .hero {
      background-color: var(--mp-color-dark--90);
      color: var(--mp-color-light--100);
    }

    .arrow-link {
      border-bottom: 1px solid var(--mp-color-light--100);
    }
  }

  /* Mobile Responsive */
  @media only screen and (max-width: 660px) {
    .hero {
      min-height: 116px;
    }

    .hero h1 {
      white-space: initial;
      line-height: 50px;
    }

    .hero h3 {
      white-space: initial;
      line-height: 40px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Typing animation for the heading
  function typeText(text: string, element: HTMLElement, position: number, delay: number) {
    element.innerText = text.substring(0, position);
    position += 1;

    if (position < text.length + 1) {
      setTimeout(() => requestAnimationFrame(() => typeText(text, element, position, delay)), delay);
    }
  }

  // Initialize typing animation on page load
  document.addEventListener('DOMContentLoaded', () => {
    const titleEl = document.getElementById('title');
    const subtitleEl = document.getElementById('subtitle');

    if (titleEl && subtitleEl) {
      titleEl.innerText = ' ';
      subtitleEl.innerText = ' ';

      // Start typing "Margriet Prinssen"
      typeText("Margriet Prinssen", titleEl, 1, 85);

      // After 1775ms, start typing "Theaterjournalistiek"
      setTimeout(() => {
        typeText("Theaterjournalistiek", subtitleEl, 1, 85);
      }, 1775);
    }
  });
</script>
