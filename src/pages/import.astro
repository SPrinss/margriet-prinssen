---
import PageLayout from '../layouts/PageLayout.astro';
import MpImportContent from '../components/lit/MpImportContent';
---

<PageLayout
  title="Bestanden importeren - Margriet Prinssen"
  description="Importeer recensies en interviews vanuit .docx bestanden."
>
  <div class="import-page">
    <header>
      <h3>Bestanden importeren</h3>
      <p>
        Sleep .docx bestanden hierheen. Elk bestand wordt automatisch gelezen; controleer de
        velden, koppel aan bestaande records of maak nieuwe aan, en accepteer elk bestand.
        Pas als alles geaccepteerd is kan er naar de database geschreven worden.
      </p>
    </header>
    <MpImportContent client:only="lit" />
  </div>
</PageLayout>

<style>
  .import-page {
    max-width: var(--mp-page-max-width, 1080px);
    margin: 0 auto;
    padding: 0 var(--mp-size--5, 20px);
    min-height: calc(100vh - 200px);
  }

  header {
    text-align: center;
    padding: var(--mp-size--6, 24px) 0;
  }

  header p {
    max-width: 660px;
    margin: var(--mp-size--3, 12px) auto 0;
  }

  .import-page :global(mp-import-content) {
    display: block;
    width: 100%;
  }
</style>
