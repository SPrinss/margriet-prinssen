---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
  currentPage?: string;
}

const {
  title,
  description,
  showFooter = false,
  currentPage = ''
} = Astro.props;

// Get current path for active nav state
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/' || pathname === '/home';
  }
  return pathname.startsWith(href);
};
---

<BaseLayout title={title} description={description}>
  <div class="app-container">
    <nav>
      <ul>
        <li>
          <a href="/" data-active={isActive('/')}>Home</a>
        </li>
        <li>
          <a href="/recensies" data-active={isActive('/recensies')}>Recensies</a>
        </li>
        <li>
          <a href="/interviews" data-active={isActive('/interviews')}>Interviews</a>
        </li>
        <li>
          <a href="/over" data-active={isActive('/over')}>Over</a>
        </li>
      </ul>
    </nav>

    <div class="divider-container">
      <div class="divider-lines left">
        <div class="line-top"></div>
        <div class="line-bottom"></div>
      </div>
      <svg class="owl-logo" viewBox="0 0 34 34" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M17 0C7.6 0 0 7.6 0 17s7.6 17 17 17 17-7.6 17-17S26.4 0 17 0zm-6 28.8l1.3-1.7h10.1l1.4 1.7H11zm15-1.7c-5.3 0-7.8-5.6-9-10.9-1.2 5.3-3.7 10.9-9 10.9V6.9h.1c.1.5 1 3 9.1 3 6.2 0 8.2-1.4 8.8-2.3v19.5z" fill="currentColor"/>
      </svg>
      <div class="divider-lines right">
        <div class="line-top"></div>
        <div class="line-bottom"></div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    {showFooter && (
      <footer>
        <p>Met liefde gemaakt door Sam Prinssen, Tijl Prinssen & Lex van der Slot</p>
      </footer>
    )}
  </div>
</BaseLayout>

<style>
  .app-container {
    position: relative;
    height: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow-x: hidden;
    background-color: var(--mp-color-secondary--20);
  }

  nav {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    max-width: 1080px;
    margin: auto;
    padding: var(--mp-size--5) var(--mp-size--5);
    z-index: 2;
    color: var(--mp-color-dark--100);
    background-color: var(--mp-color-secondary--20);
  }

  nav ul {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav ul li {
    margin: 0 12px;
  }

  nav ul li:last-of-type {
    margin-right: 0;
  }

  nav ul li a {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-family: var(--mp-text-c1-font-family, var(--mp-text-c-font-family));
    font-size: var(--mp-text-c1-font-size);
    font-weight: var(--mp-text-c1-font-weight, var(--mp-text-c-font-weight));
    line-height: var(--mp-text-c1-line-height, var(--mp-text-c-line-height));
    color: var(--mp-color-dark--50);
    text-decoration: none;
  }

  nav ul li a[data-active='true'] {
    color: var(--mp-color-dark--100);
    padding-bottom: var(--mp-size--2);
    border-bottom: 1px solid var(--mp-color-dark--100);
  }

  main {
    flex: 1;
    display: block;
    background-color: var(--mp-color-secondary--20);
  }

  /* Divider with owl logo */
  .divider-container {
    display: flex;
    flex-direction: row;
    width: 100%;
    flex-wrap: nowrap;
    align-items: flex-start;
    background-color: var(--mp-color-secondary--20);
  }

  .divider-lines {
    flex: 1;
  }

  .divider-lines .line-top,
  .divider-lines .line-bottom {
    width: 100%;
    height: 2px;
  }

  .divider-lines .line-top {
    margin-top: var(--mp-size--4);
  }

  .divider-lines .line-bottom {
    margin-top: var(--mp-size--2);
  }

  .divider-lines.left .line-top {
    background: linear-gradient(90deg, var(--mp-color-main--100) 79%, transparent 79%);
  }

  .divider-lines.left .line-bottom {
    background: linear-gradient(90deg, var(--mp-color-secondary--100) 58%, transparent 58%);
  }

  .divider-lines.right .line-top {
    background: linear-gradient(90deg, transparent 21%, var(--mp-color-main--100) 21%);
  }

  .divider-lines.right .line-bottom {
    background: linear-gradient(90deg, transparent 42%, var(--mp-color-secondary--100) 42%);
  }

  .owl-logo {
    height: 52px;
    padding: 0 var(--mp-size--5);
    color: var(--mp-color-dark--100);
    flex-shrink: 0;
  }

  /* Animation for decorative lines */
  .divider-lines.left .line-top,
  .divider-lines.left .line-bottom {
    --move-value-step-0: -10vw;
    transform: translateX(var(--move-value-step-0));
    animation: horizontal-move 0.15s forwards linear;
  }

  .divider-lines.right .line-top,
  .divider-lines.right .line-bottom {
    --move-value-step-0: 10vw;
    transform: translateX(var(--move-value-step-0));
    animation: horizontal-move 0.15s forwards linear;
  }

  @keyframes horizontal-move {
    100% {
      transform: translateX(0);
    }
  }

  footer {
    background-color: var(--mp-color-main--100);
    color: var(--mp-color-dark--100);
    display: flex;
    align-items: center;
  }

  footer > :global(*) {
    max-width: 1080px;
    margin: auto;
    padding: var(--mp-size--5);
  }

  /* Dark Mode */
  @media (prefers-color-scheme: dark) {
    .app-container,
    nav,
    main,
    .divider-container {
      background-color: var(--mp-color-dark--90);
    }

    nav {
      color: var(--mp-color-light--100);
    }

    nav ul li a {
      color: var(--mp-color-light--70);
    }

    nav ul li a[data-active='true'] {
      color: var(--mp-color-light--90);
      border-bottom: 1px solid var(--mp-color-light--90);
    }

    .owl-logo {
      color: var(--mp-color-light--100);
    }

    footer {
      background-color: var(--mp-color-dark--60);
      color: var(--mp-color-light--100);
    }
  }

  /* Mobile Responsive */
  @media only screen and (max-width: 660px) {
    nav ul {
      justify-content: space-between;
      flex-wrap: wrap;
      width: 100%;
    }

    nav ul li {
      padding: 0;
      margin: var(--mp-size--3) 0;
    }

    nav ul li a {
      font-size: var(--mp-text-c1-mobile-font-size);
    }
  }
</style>
