<style>
  nav {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--mp-size--5) var(--mp-size--5);
    z-index: 2;
    color: var(--mp-color-dark--100);
    background-color: var(--mp-color-secondary--20);
  }

  .logo {
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .logo svg {
    width: 176px;
    height: 34px;
  }

  ul {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    margin: 0 12px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  li:last-of-type {
    margin-right: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ul a {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-family: var(--mp-text-c1-font-family, var(--mp-text-c-font-family, 'Work Sans', sans-serif));
    font-size: var(--mp-text-c1-font-size, 16px);
    font-weight: var(--mp-text-c1-font-weight, var(--mp-text-c-font-weight, 400));
    line-height: var(--mp-text-c1-line-height, var(--mp-text-c-line-height, 145%));
    color: var(--mp-color-dark--50);
    transition: color 0.2s ease;
  }

  ul a:hover {
    color: var(--mp-color-dark--80);
  }

  ul a[data-active] {
    color: var(--mp-color-dark--100);
    padding-bottom: var(--mp-size--2, 8px);
    border-bottom: 1px solid var(--mp-color-dark--100);
  }

  /* Dark mode styles */
  @media (prefers-color-scheme: dark) {
    nav {
      background-color: var(--mp-color-dark--90);
    }

    ul a {
      color: var(--mp-color-light--70);
    }

    ul a:hover {
      color: var(--mp-color-light--80);
    }

    ul a[data-active] {
      color: var(--mp-color-light--90);
      border-bottom: 1px solid var(--mp-color-light--90);
    }
  }

  /* Mobile responsive styles at 660px breakpoint */
  @media only screen and (max-width: 660px) {
    nav {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--mp-size--4, 16px);
    }

    .logo svg {
      width: 140px;
      height: auto;
    }

    ul {
      justify-content: space-between;
      flex-wrap: wrap;
      width: 100%;
    }

    li {
      padding: 0;
      margin: var(--mp-size--3, 12px) 0;
    }

    ul a {
      font-size: var(--mp-text-c1-mobile-font-size, 14px);
    }
  }
</style>
