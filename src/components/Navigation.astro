  <ul>
    {navItems.map(item => (
      <li>
        <a
          href={item.href}
          data-active={isActive(item.page) ? true : undefined}
          aria-current={isActive(item.page) ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
