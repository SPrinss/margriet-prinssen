---
interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home', page: 'home' },
  { href: '/recensies', label: 'Recensies', page: 'recensies' },
  { href: '/interviews', label: 'Interviews', page: 'interviews' },
  { href: '/over', label: 'Over', page: 'over' },
];

const isActive = (page: string) => currentPage.toLowerCase() === page;
---

