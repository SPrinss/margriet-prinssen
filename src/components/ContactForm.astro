---
// ContactForm.astro
// Static contact form with minimal client-side JavaScript for submission
---

<section class="contact-section">
  <div class="top-hor-line-1"></div>
  <div class="bottom-hor-line-1"></div>

  <h4 class="text-centered">Stuur mij een berichtje</h4>

  <form id="contact-form" class="contact-container">
    <div class="contact-textarea-container">
      <label for="message" class="visually-hidden">Bericht</label>
      <textarea
        id="message"
        name="message"
        placeholder="Bericht"
        required
        aria-label="Bericht"
      ></textarea>
    </div>
    <div class="contact-inputs-container">
      <label for="name" class="visually-hidden">Naam</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Naam"
        required
        aria-label="Naam"
      />

      <label for="contactInfo" class="visually-hidden">Email of telefoonnummer</label>
      <input
        type="text"
        id="contactInfo"
        name="contactInfo"
        placeholder="Email/06"
        required
        aria-label="Email of telefoonnummer"
      />

      <button type="submit" id="submit-btn" disabled>Verstuur</button>
    </div>
  </form>

  <p id="message-status" class="message-status" aria-live="polite"></p>

  <div class="top-hor-line-2"></div>
  <div class="bottom-hor-line-2"></div>
</section>

<style>
  .contact-section {
    width: 100%;
  }

  .text-centered {
    text-align: center;
    margin-top: 0;
    margin-bottom: var(--mp-size--7, 32px);
    font-family: var(--mp-text-h-font-family, 'Raleway', serif);
    font-size: var(--mp-text-h4-font-size, 26px);
    font-weight: var(--mp-text-h4-font-weight, 600);
    line-height: var(--mp-text-h-line-height, 110%);
  }

  .contact-container {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-height: 170px;
  }

  .contact-textarea-container {
    display: block;
    margin-right: var(--mp-size--5, 20px);
    width: 360px;
    min-height: 166px;
  }

  .contact-inputs-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    height: 100%;
  }

  .contact-inputs-container > *:not(:first-child) {
    margin-top: var(--mp-size--3, 12px);
  }

  /* Visually hidden but accessible to screen readers */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Input styles */
  input {
    width: 100%;
    max-width: 360px;
    margin: 0;
    height: var(--mp-size--9, 48px);
    padding: 0 var(--mp-size--4, 16px);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-family: var(--mp-text-b-font-family, 'Work Sans', sans-serif);
    font-size: var(--mp-text-b2-font-size, 18px);
    font-weight: var(--mp-text-b-font-weight, 400);
    line-height: var(--mp-text-b-line-height, 150%);
    background: var(--mp-color-light--80, rgba(255, 255, 255, 0.8));
    color: var(--mp-color-dark--50, #7f7f7f);
    border-radius: var(--mp-border-radius--1, 5px) var(--mp-border-radius--1, 5px) 0 0;
    border: 0;
    transition: 0.2s background-color ease;
    cursor: pointer;
    box-sizing: border-box;
  }

  input:hover {
    background: var(--mp-color-light--90, rgba(255, 255, 255, 0.9));
  }

  input:focus {
    background: var(--mp-color-light--100, #fff);
    color: var(--mp-color-dark--90, #191919);
    outline: 2px solid var(--mp-color-main--100, #b2cdff);
    outline-offset: 2px;
  }

  /* Textarea styles */
  textarea {
    width: 100%;
    height: 100%;
    min-height: 166px;
    margin: 0;
    padding: var(--mp-size--3, 12px) var(--mp-size--4, 16px) 0 var(--mp-size--4, 16px);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-family: var(--mp-text-b-font-family, 'Work Sans', sans-serif);
    font-size: var(--mp-text-b2-font-size, 18px);
    font-weight: var(--mp-text-b-font-weight, 400);
    line-height: var(--mp-text-b-line-height, 150%);
    background: var(--mp-color-light--80, rgba(255, 255, 255, 0.8));
    color: var(--mp-color-dark--50, #7f7f7f);
    border-radius: var(--mp-border-radius--1, 5px);
    border: 0;
    transition: 0.2s background-color ease;
    cursor: pointer;
    resize: none;
    box-sizing: border-box;
  }

  textarea:hover {
    background: var(--mp-color-light--90, rgba(255, 255, 255, 0.9));
  }

  textarea:focus {
    background: var(--mp-color-light--100, #fff);
    color: var(--mp-color-dark--90, #191919);
    outline: 2px solid var(--mp-color-main--100, #b2cdff);
    outline-offset: 2px;
  }

  /* Button styles */
  button {
    height: var(--mp-size--9, 48px);
    padding: 0 var(--mp-size--4, 16px);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-family: var(--mp-text-b-font-family, 'Work Sans', sans-serif);
    font-size: var(--mp-text-b2-font-size, 18px);
    font-weight: var(--mp-text-b-font-weight, 400);
    line-height: var(--mp-text-b-line-height, 150%);
    background-color: var(--mp-color-main--100, #b2cdff);
    color: var(--mp-color-dark--100, #000);
    border-radius: var(--mp-border-radius--1, 5px);
    border: 2px solid transparent;
    cursor: pointer;
    transition: 0.2s background-color ease;
  }

  button:hover:not(:disabled) {
    background-color: var(--mp-color-main--90, #b9d2ff);
  }

  button:active:not(:disabled) {
    background-color: var(--mp-color-main--100, #b2cdff);
  }

  button:focus {
    outline: 2px solid var(--mp-color-main--100, #b2cdff);
    outline-offset: 2px;
  }

  button:disabled {
    cursor: default;
    opacity: 0.4;
  }

  /* Status message */
  .message-status {
    text-align: center;
    min-height: 1.5em;
    font-family: var(--mp-text-b-font-family, 'Work Sans', sans-serif);
    font-size: var(--mp-text-b2-font-size, 18px);
  }

  /* Decorative lines */
  .top-hor-line-1,
  .bottom-hor-line-1,
  .top-hor-line-2,
  .bottom-hor-line-2 {
    width: 100%;
    height: 2px;
    margin-top: var(--mp-size--2, 8px);
  }

  .top-hor-line-1 {
    background: linear-gradient(90deg, transparent 30%, var(--mp-color-main--100, #b2cdff) 30%, var(--mp-color-main--100, #b2cdff) 78%, transparent 78%);
  }

  .bottom-hor-line-1 {
    background: linear-gradient(90deg, transparent 40%, var(--mp-color-secondary--100, #f4d18f) 40%, var(--mp-color-secondary--100, #f4d18f) 68%, transparent 68%);
    margin-bottom: var(--mp-size--8, 40px);
  }

  .top-hor-line-2 {
    background: linear-gradient(90deg, transparent 40%, var(--mp-color-secondary--100, #f4d18f) 40%, var(--mp-color-secondary--100, #f4d18f) 68%, transparent 68%);
    margin-top: var(--mp-size--8, 40px);
  }

  .bottom-hor-line-2 {
    background: linear-gradient(90deg, transparent 30%, var(--mp-color-main--100, #b2cdff) 30%, var(--mp-color-main--100, #b2cdff) 78%, transparent 78%);
  }

  /* Mobile styles */
  @media only screen and (max-width: 660px) {
    .text-centered {
      font-size: var(--mp-text-h4-mobile-font-size, 20px);
      margin-top: var(--mp-size--5, 20px);
    }

    .contact-container {
      max-height: 100%;
    }

    .contact-textarea-container,
    .contact-inputs-container {
      width: 100%;
    }

    .contact-textarea-container {
      margin-right: 0;
      max-width: 100%;
    }

    .contact-inputs-container > * {
      margin-top: var(--mp-size--3, 12px);
    }

    input {
      min-width: 100%;
    }

    .bottom-hor-line-1 {
      margin-bottom: var(--mp-size--6, 24px);
    }

    .top-hor-line-2 {
      margin-top: var(--mp-size--6, 24px);
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const messageStatus = document.getElementById('message-status') as HTMLParagraphElement;
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const contactInput = document.getElementById('contactInfo') as HTMLInputElement;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement;

  // Enable/disable submit button based on form validity
  function updateSubmitButton() {
    const isValid = nameInput.value.trim() && contactInput.value.trim() && messageInput.value.trim();
    submitBtn.disabled = !isValid;
  }

  nameInput.addEventListener('input', updateSubmitButton);
  contactInput.addEventListener('input', updateSubmitButton);
  messageInput.addEventListener('input', updateSubmitButton);

  // Handle form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;

    try {
      const response = await fetch('https://us-central1-margriet-prinssen.cloudfunctions.net/sendEmail', {
        method: 'POST',
        body: JSON.stringify({
          name: nameInput.value,
          contactInfo: contactInput.value,
          message: messageInput.value
        })
      });

      if (response.status === 202) {
        messageStatus.textContent = 'Dank voor het bericht!';
        nameInput.value = '';
        contactInput.value = '';
        messageInput.value = '';
      } else {
        messageStatus.textContent = 'Er is helaas iets misgegaan, probeer het aub later nog eens.';
      }
    } catch {
      messageStatus.textContent = 'Er is helaas iets misgegaan, probeer het aub later nog eens.';
    }

    // Clear status message after 3 seconds
    setTimeout(() => {
      messageStatus.textContent = '';
      updateSubmitButton();
    }, 3000);
  });
</script>
